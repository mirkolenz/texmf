\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{_init}

\RequirePackage{iftex}
\newif\ifluatexorxetex
\ifpdftex\else\luatexorxetextrue\fi

\newif\if@de\@defalse
\newif\if@beamer\@beamerfalse

\DeclareOption{de}{\@detrue}
\DeclareOption{beamer}{\@beamertrue}
\DeclareOption{nonumbering}{\setcounter{secnumdepth}{0}}
\ProcessOptions\relax

\newcommand*{\languageselection}{}
\if@de
\renewcommand{\languageselection}{english,ngerman}
\else
\renewcommand{\languageselection}{ngerman,english}
\fi

\PassOptionsToPackage{\languageselection}{babel}
\PassOptionsToPackage{labelfont=bf,sf, labelsep=quad}{caption}

\RequirePackage{babel}

\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{amssymb}
\RequirePackage{siunitx}
\RequirePackage{fmtcount} % equivalent to \usepackage[super]{nth}
\sisetup{per-mode=fraction}
\RequirePackage{xfrac}

\RequirePackage[final, verbose=silent]{microtype}
% Extra line breaking pass for paragraphs that would otherwise be overfull
\setlength{\emergencystretch}{3em}
\newcommand*{\numberstyle}[1]{}

\ifluatexorxetex
\RequirePackage[quiet, no-math]{fontspec}
\RequirePackage[warnings-off={mathtools-colon, mathtools-overbracket}, math-style=ISO, mathbf=sym]{unicode-math}
\defaultfontfeatures{
  Ligatures=Common,
  Numbers={Lining, Monospaced}
}

\renewcommand{\numberstyle}[1]{\addfontfeatures{Numbers={#1}}}
\else
\RequirePackage[T1]{fontenc}
\fi

\RequirePackage{mathtools} % load after unicode-math

\RequirePackage{fontawesome7}

\if@beamer
\else
\PassOptionsToPackage{pdfusetitle}{hyperref}
\fi

\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{hyperref}
\hypersetup{hidelinks}
\RequirePackage{xurl}
\urlstyle{same}

\RequirePackage{graphicx}

\RequirePackage{fvextra} % needed by minted, must be loaded before csquotes
\RequirePackage[autostyle=true]{csquotes}
\RequirePackage[useregional, showseconds=false]{datetime2}

\if@beamer
\else
\RequirePackage[sharp]{easylist}
\RequirePackage[shortlabels]{enumitem} % inline

\newlist{enumerate*}{enumerate*}{1}
\setlist[enumerate*]{label=(\roman*)}
\fi

\RequirePackage{zref-clever}

\let\cref\zcref
\let\Cref\zcref

\if@beamer
\else
\zcsetup{noabbrev, cap}
\fi

\zcLanguageSetup{english}{
  pairsep  = { and },
  listsep  = {, },
  lastsep  = {, and },
  tpairsep = { and },
  tlistsep = {, },
  tlastsep = {, and }
}

\zcLanguageSetup{german}{
  pairsep  = { und },
  listsep  = {, },
  lastsep  = { und },
  tpairsep = { und },
  tlistsep = {, },
  tlastsep = { und }
}

\newcommand*{\schemeLink}[2]{\href{#1#2}{\nolinkurl{#2}}}
\newcommand*{\mailtoLink}[1]{\schemeLink{mailto:}{#1}}
\newcommand*{\telLink}[1]{\schemeLink{tel:}{#1}}
\newcommand*{\httpLink}[1]{\schemeLink{http://}{#1}}
\newcommand*{\httpsLink}[1]{\schemeLink{https://}{#1}}
\newcommand*{\githubLink}[1]{\httpsLink{github.com/#1}}
\newcommand*{\pypiLink}[1]{\httpsLink{pypi.org/project/#1}}
\newcommand*{\npmLink}[1]{\httpsLink{npmjs.com/package/#1}}
\newcommand*{\mavenLink}[1]{\httpsLink{search.maven.org/artifact/#1}}
\newcommand*{\anonymousGithubLink}[1]{\httpsLink{anonymous.4open.science/r/#1}}
\newcommand*{\zenodoLink}[1]{\httpsLink{zenodo.org/records/#1}}
\newcommand*{\doiLink}[1]{\httpsLink{doi.org/#1}}
\newcommand*{\orcidLink}[1]{\httpsLink{orcid.org/#1}}

\newcommand*{\Emph}[1]{{\sffamily\bfseries #1}}
\newcommand*{\separator}{\nolinebreak\hspace{.5ex}\textup{\textperiodcentered}\hspace{.5ex}}

\newcommand*{\maketoc}{
  \pagenumbering{roman}
  \tableofcontents
  \cleardoublepage
  \pagenumbering{arabic}
  \setcounter{page}{1}
}
\newcommand*{\makefrontmatter}[1]{
  \frontmatter
  \maketitle
  \tableofcontents
  #1
  \cleardoublepage
  \mainmatter
}

\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

\definecolor{fgColor}{HTML}{000000}
\definecolor{bgColor}{HTML}{FFFFFF}
